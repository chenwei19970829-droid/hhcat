{
  "entities": {
    "FeaturedModel": {
      "title": "FeaturedModel",
      "description": "Custom cat villa model shown in Featured Models section",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "tagline": { "type": "string" },
        "price": { "type": "string" },
        "originalPrice": { "type": "string" },
        "specs": { "type": "array" },
        "features": { "type": "array" },
        "highlights": { "type": "array" },
        "category": { "type": "string" },
        "dimensions": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "isCustomUpload": { "type": "boolean" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "price", "imageUrl"]
    },
    "InStockItem": {
      "title": "InStockItem",
      "description": "Ready-to-ship or showroom stock item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "sizeTag": { "type": "string" },
        "priceText": { "type": "string" },
        "status": { "type": "string" },
        "mainImage": { "type": "string" },
        "interiorImage": { "type": "string" },
        "detailImage": { "type": "string" },
        "description": { "type": "string" },
        "features": { "type": "array" },
        "isCustomUpload": { "type": "boolean" },
        "dateAdded": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "mainImage", "status"]
    },
    "ShowcasePhoto": {
      "title": "ShowcasePhoto",
      "description": "Delivered customer showcase photo and details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "client": { "type": "string" },
        "location": { "type": "string" },
        "dimensions": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "tags": { "type": "array" },
        "likes": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "imageUrl"]
    },
    "StorefrontPhoto": {
      "title": "StorefrontPhoto",
      "description": "Storefront showcase carousel photos displayed in HeroSection",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "imageUrl": { "type": "string" },
        "caption": { "type": "string", "maxLength": 200 },
        "deleted": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id"]
    },
    "AnalyticsDaily": {
      "title": "AnalyticsDaily",
      "description": "Daily website visit, device/source breakdown, and calculator usage counters (Taiwan timezone YYYY-MM-DD)",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 16, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "uniqueVisitors": { "type": "number" },
        "pageViews": { "type": "number" },
        "productPageViews": { "type": "number" },
        "showroomPageViews": { "type": "number" },
        "craftGuideViews": { "type": "number" },
        "estimatorUsers": { "type": "number" },
        "estimatorSessions": { "type": "number" },
        "estimatorActions": { "type": "number" },
        "estimatorCopies": { "type": "number" },
        "lineQuotes": { "type": "number" },
        "phoneClicks": { "type": "number" },
        "qrOpens": { "type": "number" },
        "deviceMobile": { "type": "number" },
        "deviceDesktop": { "type": "number" },
        "srcSearch": { "type": "number" },
        "srcSocial": { "type": "number" },
        "srcDirect": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "updatedAt"]
    },
    "AnalyticsPeriod": {
      "title": "AnalyticsPeriod",
      "description": "Deduplicated weekly, monthly, and yearly analytics totals (w_YYYY-MM-DD, m_YYYY-MM, y_YYYY)",
      "type": "object",
      "properties": {
        "periodType": { "type": "string", "enum": ["week", "month", "year"] },
        "periodKey": { "type": "string", "maxLength": 16 },
        "uniqueVisitors": { "type": "number" },
        "pageViews": { "type": "number" },
        "productPageViews": { "type": "number" },
        "showroomPageViews": { "type": "number" },
        "craftGuideViews": { "type": "number" },
        "estimatorUsers": { "type": "number" },
        "estimatorSessions": { "type": "number" },
        "estimatorActions": { "type": "number" },
        "estimatorCopies": { "type": "number" },
        "lineQuotes": { "type": "number" },
        "phoneClicks": { "type": "number" },
        "qrOpens": { "type": "number" },
        "deviceMobile": { "type": "number" },
        "deviceDesktop": { "type": "number" },
        "srcSearch": { "type": "number" },
        "srcSocial": { "type": "number" },
        "srcDirect": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["periodType", "periodKey", "updatedAt"]
    },
    "AnalyticsModelDaily": {
      "title": "AnalyticsModelDaily",
      "description": "Daily view and LINE quote counts per cat villa model",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 16, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "modelId": { "type": "string", "maxLength": 64 },
        "modelName": { "type": "string", "maxLength": 100 },
        "views": { "type": "number" },
        "lineQuotes": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "modelId", "modelName", "updatedAt"]
    }
  },
  "firestore": {
    "/featuredModels/{modelId}": {
      "schema": "FeaturedModel",
      "description": "Collection of featured cat villa models"
    },
    "/inStockItems/{itemId}": {
      "schema": "InStockItem",
      "description": "Collection of physical showroom and in-stock items"
    },
    "/showcasePhotos/{photoId}": {
      "schema": "ShowcasePhoto",
      "description": "Collection of customer delivery showcase photos"
    },
    "/storefrontPhotos/{photoId}": {
      "schema": "StorefrontPhoto",
      "description": "Collection of storefront real-scene carousel photos"
    },
    "/analyticsDaily/{dateId}": {
      "schema": "AnalyticsDaily",
      "description": "Daily traffic, device/source, calculator usage, and inquiry counters (owner read only)"
    },
    "/analyticsPeriods/{periodId}": {
      "schema": "AnalyticsPeriod",
      "description": "Deduplicated weekly, monthly, and yearly visitor and calculator counters (owner read only)"
    },
    "/analyticsModelDaily/{statId}": {
      "schema": "AnalyticsModelDaily",
      "description": "Daily per-model views and quote clicks (owner read only)"
    }
  }
}
